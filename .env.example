# ─────────────────────────────────────────────────────────────
# 像素画笔 PixelScribe · 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 忽略。
# ─────────────────────────────────────────────────────────────

# LLM 服务地址（OpenAI 兼容 /chat/completions）
# OpenCode Go/Zen: https://opencode.ai/zen/go/v1   （粘贴完整 .../chat/completions 也能用）
# DeepSeek 官方:    https://api.deepseek.com/v1
# OpenAI:          https://api.openai.com/v1
# 通义千问:         https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot:        https://api.moonshot.cn/v1
# 智谱:            https://open.bigmodel.cn/api/paas/v4
# OpenRouter:      https://openrouter.ai/api/v1
# 本地 Ollama:      http://127.0.0.1:11434/v1
# LM Studio:       http://127.0.0.1:1234/v1
PX_BASE_URL=https://opencode.ai/zen/go/v1

# API Key（仅存服务端，绝不下发浏览器）
PX_API_KEY=

# 模型名（必须是支持视觉输入的模型）
# 推荐 deepseek-v4.1-flash（原生多模态，同一模型写脚本 + 看图回灌）
PX_MODEL=deepseek-v4.1-flash

# 服务端口
PX_PORT=5173

# 采样温度（像素艺术建议 0.4 - 0.8）
PX_TEMPERATURE=0.6

# 默认闭环最大轮次
PX_MAX_ITERATIONS=6

# 渲染回灌时长边像素（建议 >= 256，保证模型看清像素块）
PX_VISION_LONG_EDGE=384

# 代理请求超时（毫秒）
PX_TIMEOUT_MS=180000

# 单轮最大输出 token（PixelScript 很短，2048 足够；开思考可调大）
PX_MAX_TOKENS=2048

# 思考模式：auto（已知网关自动关闭，推荐）/ disabled / enabled
PX_THINKING=auto

# 视觉回灌：auto（模型不接受图片时自动降级为纯文本审查）/ on / off
PX_VISION=auto

# 可选：复用鲸语 WhaleTalk 的 config.json（取 base_url / model）
# 注意：其 api_key 经 Windows DPAPI 加密，Node 端无法解密，仍需在上面填 PX_API_KEY。
# PX_GATEWAY_CONFIG=E:\tengxun\WhaleTalk\config.json
