# ─────────────────────────────────────────────────────────────
# 像素画笔 PixelScribe · 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 忽略。
# ─────────────────────────────────────────────────────────────

# LLM 服务地址（OpenAI 兼容 /chat/completions）
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
# 通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot:    https://api.moonshot.cn/v1
# 智谱:        https://open.bigmodel.cn/api/paas/v4
# OpenRouter:  https://openrouter.ai/api/v1
# 本地 Ollama:  http://127.0.0.1:11434/v1
# LM Studio:   http://127.0.0.1:1234/v1
PX_BASE_URL=https://api.openai.com/v1

# API Key（仅存服务端，绝不下发浏览器）
PX_API_KEY=

# 模型名（必须是支持视觉输入的模型）
# 例如 gpt-4o / gpt-4o-mini / qwen-vl-max / glm-4v / gemini-2.0-flash / llava
PX_MODEL=gpt-4o-mini

# 服务端口
PX_PORT=5173

# 采样温度（像素艺术建议 0.4 - 0.8）
PX_TEMPERATURE=0.6

# 默认闭环最大轮次
PX_MAX_ITERATIONS=6

# 渲染回灌时长边像素（建议 >= 256，保证模型看清像素块）
PX_VISION_LONG_EDGE=384

# 代理请求超时（毫秒）
PX_TIMEOUT_MS=120000
